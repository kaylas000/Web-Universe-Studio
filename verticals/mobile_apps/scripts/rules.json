{
  "vertical": "mobile_apps",
  "rules": [
    {
      "code": "V-01",
      "title": "Гайдлайны платформы (HIG / Material 3)",
      "kind": "allOf",
      "rules": [
        {
          "kind": "textHasAny",
          "path": "README.md",
          "patterns": [
            "HIG|Human Interface"
          ]
        },
        {
          "kind": "textHasAny",
          "path": "README.md",
          "patterns": [
            "Material"
          ]
        }
      ],
      "ok": "учтены HIG и Material Design 3",
      "fail": "нет привязки к гайдлайнам платформы (К-01) · гайдлайн-чек (HIG/M3) + LLM-judge (по умолчанию off)"
    },
    {
      "code": "V-02",
      "title": "Safe Area (notch / home indicator)",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "SafeAreaView|SafeArea|safeAreaInset",
      "min": 1,
      "ok": "контент в безопасной зоне",
      "fail": "нет Safe Area (К-02)"
    },
    {
      "code": "V-03",
      "title": "Тач-таргеты ≥ 44/48",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "minHeight=\\{(44|48)\\}|minHeight:\\s*(44|48)|hitSlop",
      "min": 1,
      "ok": "тач-таргеты не меньше нормы",
      "fail": "мелкие тач-таргеты (К-03)"
    },
    {
      "code": "V-04",
      "title": "4 состояния экрана",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "Loading",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "Empty",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "Error",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "Success",
          "min": 1
        }
      ],
      "ok": "есть Loading/Empty/Error/Success",
      "fail": "нет всех 4 состояний экрана (К-04)"
    },
    {
      "code": "V-05",
      "title": "Тёмная тема",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "useColorScheme|Appearance|colorScheme",
      "min": 1,
      "ok": "тема реагирует на системную",
      "fail": "нет поддержки тёмной темы (К-05)"
    },
    {
      "code": "V-06",
      "title": "Запуск < 2 c, FPS ≥ 55",
      "kind": "anyOf",
      "rules": [
        {
          "kind": "allOf",
          "rules": [
            {
              "kind": "jsonNumberMax",
              "path": "app/perf.json",
              "key": "start_ms",
              "max": 2000
            },
            {
              "kind": "jsonNumberMin",
              "path": "app/perf.json",
              "key": "fps",
              "min": 55
            }
          ]
        },
        {
          "kind": "allOf",
          "rules": [
            {
              "kind": "jsonNumberMax",
              "path": "app/bundle.json",
              "key": "start_ms",
              "max": 2000
            },
            {
              "kind": "jsonNumberMin",
              "path": "app/bundle.json",
              "key": "fps",
              "min": 55
            }
          ]
        }
      ],
      "ok": "производительность в бюджете",
      "fail": "просадка старта/FPS (К-06) · bundle.json/perf-report.json (jsonNumberMax, Flipper/DevTools)"
    },
    {
      "code": "V-07",
      "title": "Offline: кэш и очередь",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "NetInfo",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "AsyncStorage|Storage|cache",
          "min": 1
        }
      ],
      "ok": "есть слушатель сети и локальное хранилище",
      "fail": "нет offline-режима (К-07)"
    },
    {
      "code": "V-08",
      "title": "Нативный стек навигации",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "createNativeStackNavigator|NavigationContainer|go_router|NavigationStack|react-navigation",
      "min": 1,
      "ok": "используется нативный стек",
      "fail": "кастомный стек без анимаций (К-08)"
    },
    {
      "code": "V-09",
      "title": "Клавиатура не перекрывает поля",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "KeyboardAvoidingView|Scaffold",
      "min": 1,
      "ok": "поля уходят из-под клавиатуры",
      "fail": "нет KeyboardAvoidingView/Scaffold (К-09)"
    },
    {
      "code": "V-10",
      "title": "Адаптивный layout на планшетах",
      "kind": "jsonArrayMinItems",
      "path": "app/screenshots.json",
      "key": "tablet",
      "min": 1,
      "ok": "есть скриншоты планшета",
      "fail": "нет адаптации под планшеты (К-10) · скриншоты"
    },
    {
      "code": "V-11",
      "title": "Accessibility-подписи",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "accessibilityLabel|aria-label|semanticLabel",
      "min": 1,
      "ok": "интерактив подписан для скринридера",
      "fail": "нет accessibilityLabel/semanticLabel (К-11)"
    },
    {
      "code": "V-12",
      "title": "Разрешения по запросу, не на старте",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "requestPermission",
          "min": 1
        },
        {
          "kind": "regexAbsent",
          "path": "app/src/App.mjs",
          "pattern": "componentDidMount|initState"
        }
      ],
      "ok": "разрешения запрашиваются в момент использования",
      "fail": "запрос разрешений на старте (К-12) · статанализ"
    },
    {
      "code": "V-13",
      "title": "Deep links (universal/app links)",
      "kind": "jsonHas",
      "path": "app/app.json",
      "keys": [
        "scheme"
      ],
      "ok": "deep links объявлены",
      "fail": "нет обработки deep links (К-13)"
    },
    {
      "code": "V-14",
      "title": "Локализация en + ru",
      "kind": "allOf",
      "rules": [
        {
          "kind": "filesExist",
          "paths": [
            "app/locales/ru.json",
            "app/locales/en.json"
          ]
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "i18n|intl|Localizable",
          "min": 1
        }
      ],
      "ok": "два языка через i18n",
      "fail": "нет i18n на 2 языка (К-14)"
    },
    {
      "code": "V-15",
      "title": "Push через FCM / APNs",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "onMessage|messaging|firebase|FCM",
      "min": 1,
      "ok": "есть обработчик push",
      "fail": "нет onMessage-обработчика (К-15)"
    },
    {
      "code": "V-16",
      "title": "Единый стейт-менеджер",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "createStore|zustand|createSlice|useReducer|Provider|Riverpod|Bloc",
      "min": 1,
      "ok": "состояние в одном сторе",
      "fail": "prop drilling/нет стора (К-16)"
    },
    {
      "code": "V-17",
      "title": "Retry и понятные ошибки",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "retry|attempts",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "catch",
          "min": 1
        }
      ],
      "ok": "есть retry и обработка ошибок",
      "fail": "нет retry/UI-фидбека (К-17)"
    },
    {
      "code": "V-18",
      "title": "5+ разрешений экрана",
      "kind": "allOf",
      "rules": [
        {
          "kind": "jsonArrayMinItems",
          "path": "app/devices-report.json",
          "key": "devices",
          "min": 5
        },
        {
          "kind": "jsonArrayEveryHas",
          "path": "app/devices-report.json",
          "key": "devices",
          "fields": [
            "device",
            "width",
            "height"
          ]
        }
      ],
      "ok": "проверено на 5+ разрешениях",
      "fail": "меньше 5 разрешений (К-18) · devices-report.json (Detox/Appium, iPhone SE…Android 600dp)"
    },
    {
      "code": "V-19",
      "title": "Биометрия через нативные API",
      "kind": "regexAtLeast",
      "path": "app/src/App.mjs",
      "pattern": "biometric|local_auth|LocalAuthentication|Biometrics",
      "min": 1,
      "ok": "биометрия через нативный API",
      "fail": "нет нативной биометрии (К-19)"
    },
    {
      "code": "V-20",
      "title": "Готовность к сторам",
      "kind": "allOf",
      "rules": [
        {
          "kind": "fileExists",
          "path": "app/assets/icon-1024.png"
        },
        {
          "kind": "fileExists",
          "path": "app/screenshots/manifest.json"
        },
        {
          "kind": "jsonHas",
          "path": "app/store.json",
          "keys": [
            "icon",
            "screenshots",
            "description"
          ]
        }
      ],
      "ok": "иконка 1024 и метаданные стора на месте",
      "fail": "нет иконки/скриншотов/описания (К-20) · assets/icon-1024.png + screenshots/ (store-checklist.mjs)"
    },
    {
      "code": "V-21",
      "title": "Микрокопи: без штампов, ошибка с решением",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAbsent",
          "path": "app/locales/ru.json",
          "pattern": "индивидуальн\\w*\\s+подход|высок\\w*\\s+качеств|инновационн\\w*|динамичн\\w*\\s+развивающ|лидер\\w*\\s+рынк"
        },
        {
          "kind": "implies",
          "path": "app/locales/ru.json",
          "if": "не удалось|ошибк|поврежд[её]н",
          "then": [
            "повторите|попробуйте|проверьте|начните"
          ]
        }
      ],
      "ok": "микрокопи без маркетинговых штампов; ошибки содержат следующий шаг",
      "fail": "штампы или ошибка без решения (К-21) · прокси: скан locales/ru.json; штампы и «нажмите сюда» — B-07…B-10 в lint-slop"
    },
    {
      "code": "V-22",
      "title": "Контраст текста ≥ 4.5:1 (WCAG AA)",
      "kind": "themeContrast",
      "path": "app/theme.json",
      "min": 4.5,
      "ok": "все пары текст/фон в светлой и тёмной темах проходят WCAG AA (≥ 4.5:1)",
      "fail": "есть пара текст/фон ниже 4.5:1 (К-22) · таблица токенов app/theme.json (пары contrast); расчёт по WCAG 2.1"
    },
    {
      "code": "V-23",
      "title": "Эвристики NN/g: статус, выход, ошибки, распознавание, справка",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "NetInfo|status:",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "createNativeStackNavigator|go_router|NavigationStack",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "attempts|retry",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "accessibilityLabel|semanticLabel|aria-label",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "i18n\\.t\\(\"help\"\\)",
          "min": 1
        }
      ],
      "ok": "эвристики NN/g закрыты: системный статус (NetInfo/status), нативный стек (выход), предотвращение ошибок (retry), распознавание (подписи), справка (i18n help)",
      "fail": "провалена эвристика NN/g (К-23) · прокси: NetInfo/status, createNativeStackNavigator, attempts/retry, accessibilityLabel, i18n.t(\"help\") — карта в HEURISTICS.md"
    },
    {
      "code": "V-24",
      "title": "Типографика: кегль ≥16 базовый, контент ≥14, интерлиньяж ≥20 (К-24)",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "fontSize=\\s*\\{\\s*(1[6-9]|2\\d|3\\d)\\s*\\}",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "fontSize=\\s*\\{\\s*(1[4-9]|2\\d|3\\d)\\s*\\}",
          "min": 2
        },
        {
          "kind": "regexAbsent",
          "path": "app/src/App.mjs",
          "pattern": "fontSize=\\s*\\{\\s*1[0-3]\\s*\\}"
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "lineHeight=\\s*\\{\\s*(2\\d|3\\d)\\s*\\}",
          "min": 2
        },
        {
          "kind": "regexAbsent",
          "path": "app/src/App.mjs",
          "pattern": "lineHeight=\\s*\\{\\s*1[0-9]\\s*\\}"
        }
      ],
      "ok": "типографика в нормах: базовый кегль ≥16, контент ≥14, нет мелких кеглей и удушающего межстрочного (V-24)",
      "fail": "типографика вне норм (К-24) · прокси: fontSize={≥16} базовый, {≥14} контент (regexAbsent рубит {<14}), lineHeight={≥20}; реальные pt/dp меряет Flipper/Flutter DevTools на тире"
    },
    {
      "code": "V-25",
      "title": "Анимации 60fps: нативный драйвер, кадровая модель, без блокировок (К-25)",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "Animated\\.(timing|spring|parallel|sequence|event)\\(",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "useNativeDriver:\\s*true",
          "min": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "app/src/App.mjs",
          "pattern": "requestAnimationFrame|Easing\\.",
          "min": 1
        },
        {
          "kind": "regexAbsent",
          "path": "app/src/App.mjs",
          "pattern": "setTimeout\\([\\s\\S]{0,120}?[5-9]\\d\\d\\)|setTimeout\\([\\s\\S]{0,120}?\\d{4,}\\)"
        }
      ],
      "ok": "анимации в 60fps: нативный драйвер (useNativeDriver), кадровая модель rAF/Easing, без блокирующих задержек главного потока (V-25)",
      "fail": "анимации вне норм (К-25) · прокси: Animated.timing + useNativeDriver: true + requestAnimationFrame/Easing (regexAbsent рубит setTimeout ≥500мс); 60fps на тире меряет Profiler"
    },
    {
      "code": "V-26",
      "title": "Биометрия: проверка железа до запроса (К-19)",
      "kind": "implies",
      "path": "app/src/App.mjs",
      "if": "biometric|Biometric|FaceID|TouchID|LocalAuthentication",
      "then": [
        "hasHardwareAsync|canAuthenticate|isEnrolledAsync|isSensorAvailable|canPromptBiometric"
      ],
      "ok": "биометрия вызывается только после проверки доступности",
      "fail": "биометрия без проверки железа — на устройстве без датчика поток падает (К-19)"
    },
    {
      "code": "V-27",
      "title": "Локали ru/en: паритет ключей (К-14)",
      "kind": "jsonKeysParity",
      "paths": [
        "app/locales/ru.json",
        "app/locales/en.json"
      ],
      "ok": "ru и en описывают один и тот же набор строк",
      "fail": "локали разошлись: ключ есть в одном языке и отсутствует в другом (К-14)"
    },
    {
      "code": "V-28",
      "title": "Описание в сторе ≥ 60 символов (К-20)",
      "kind": "jsonStringLength",
      "path": "app/store.json",
      "fields": [
        {
          "key": "description",
          "min": 60
        }
      ],
      "ok": "описание стора содержательно, а не заглушка",
      "fail": "описание стора короче 60 символов — модерация и поиск не поймут приложение (К-20)"
    },
    {
      "code": "V-29",
      "title": "Флаги платформы в манифесте приложения (К-26)",
      "kind": "jsonHas",
      "path": "app/app.json",
      "keys": [
        "designSystem",
        "tabletSupport",
        "permissionsOnDemand"
      ],
      "ok": "манифест объявляет дизайн-систему, планшеты и запрос разрешений по действию",
      "fail": "в app.json нет designSystem/tabletSupport/permissionsOnDemand (К-26)"
    }
  ]
}
