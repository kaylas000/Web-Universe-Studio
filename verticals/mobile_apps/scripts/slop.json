{
  "vertical": "mobile_apps",
  "scan": [
    "app"
  ],
  "extensions": [
    ".mjs",
    ".json",
    ".md"
  ],
  "rules": [
    {
      "code": "B-05",
      "pattern": "Alert\\.alert\\(",
      "message": "alert вместо нативного UI (B-05)"
    },
    {
      "code": "B-03",
      "pattern": "javaScriptEnabled:\\s*true",
      "message": "WebView без sandbox (B-03)"
    }
  ]
}
