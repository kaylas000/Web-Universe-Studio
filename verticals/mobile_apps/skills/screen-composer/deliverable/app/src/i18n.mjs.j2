/* Мини-i18n: ru + en без внешних зависимостей. */
const dict = {
  ru: { title: "Заметки", add: "Добавить", unlock: "Войти по биометрии" },
  en: { title: "Notes", add: "Add", unlock: "Sign in with biometrics" },
};

let lang = "ru";

export const i18n = {
  t: (key) => (dict[lang][key] !== undefined ? dict[lang][key] : key),
  set: (next) => { lang = next; },
};

export default i18n;
