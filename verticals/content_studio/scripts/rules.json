{
  "vertical": "content_studio",
  "rules": [
    {
      "code": "V-01",
      "title": "Уникальность текста",
      "kind": "uniqueShingles",
      "path": "content/post.md",
      "size": 5,
      "min": 0.9,
      "ok": "доля уникальных шинглов ≥ 0,9",
      "fail": "текст содержит повторы (К-01) · прокси lint-unique"
    },
    {
      "code": "V-02",
      "title": "Плотность ключевого слова 1–3 %",
      "kind": "keywordDensity",
      "path": "content/post.md",
      "keyword": "данн",
      "min": 1,
      "max": 3,
      "ok": "плотность ключа в норме",
      "fail": "переспам или недобор ключа (К-02)"
    },
    {
      "code": "V-03",
      "title": "Читаемость ≥ 60",
      "kind": "readabilityMin",
      "path": "content/post.md",
      "min": 60,
      "ok": "адаптированный Flesch ≥ 60",
      "fail": "текст труднее порога (К-03) · прокси lint-readability"
    },
    {
      "code": "V-04",
      "title": "Структура: один H1 и иерархия H2",
      "kind": "allOf",
      "rules": [
        {
          "kind": "headingCount",
          "path": "content/post.md",
          "level": 1,
          "min": 1,
          "max": 1
        },
        {
          "kind": "regexAtLeast",
          "path": "content/post.md",
          "pattern": "^##\\s+",
          "min": 2
        }
      ],
      "ok": "ровно один H1 и ≥2 H2",
      "fail": "сломана иерархия заголовков (К-04)"
    },
    {
      "code": "V-05",
      "title": "Мета: title 50–60, description 120–158",
      "kind": "jsonStringLength",
      "path": "content/meta.json",
      "fields": [
        {
          "key": "title",
          "min": 50,
          "max": 60
        },
        {
          "key": "description",
          "min": 120,
          "max": 158
        }
      ],
      "ok": "мета в пределах лимитов",
      "fail": "title/description вне лимитов (К-05) · прокси seo-gate"
    },
    {
      "code": "V-06",
      "title": "Внутренние и внешние ссылки",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "content/post.md",
          "pattern": "\\]\\(/",
          "min": 2
        },
        {
          "kind": "regexAtLeast",
          "path": "content/post.md",
          "pattern": "\\]\\(https?://",
          "min": 1
        }
      ],
      "ok": "≥2 внутренних и ≥1 внешняя ссылка",
      "fail": "не хватает ссылок (К-06)"
    },
    {
      "code": "V-07",
      "title": "Нет штампов и воды",
      "kind": "regexAbsent",
      "path": "content/post.md",
      "pattern": "эффективн|уникальн(ый|ое) решени|команда профессионалов",
      "ok": "штампов нет",
      "fail": "найден штамп (К-07) · см. lint-copy"
    },
    {
      "code": "V-08",
      "title": "Факты со сноской на источник",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "content/post.md",
          "pattern": "\\[\\^?\\d+\\]",
          "min": 2
        },
        {
          "kind": "fileExists",
          "path": "content/SOURCES.md"
        }
      ],
      "ok": "цифры и факты со сносками",
      "fail": "нет сносок/источников (К-08) · прокси lint-facts"
    },
    {
      "code": "V-09",
      "title": "Tone of voice из брифа",
      "kind": "textHasAll",
      "path": "content/README.md",
      "patterns": [
        "Tone of voice"
      ],
      "ok": "tone of voice зафиксирован",
      "fail": "tone of voice не задан (К-09) · прокси LLM-judge"
    },
    {
      "code": "V-10",
      "title": "Атрибуция (E-E-A-T)",
      "kind": "textHasAll",
      "path": "content/README.md",
      "patterns": [
        "Автор"
      ],
      "ok": "автор указан",
      "fail": "нет атрибуции (К-10)"
    },
    {
      "code": "V-11",
      "title": "Изображения с alt",
      "kind": "allOf",
      "rules": [
        {
          "kind": "regexAtLeast",
          "path": "content/post.md",
          "pattern": "!\\[[^\\]]+\\]\\(",
          "min": 1
        }
      ],
      "ok": "изображение с alt-текстом",
      "fail": "нет изображения с alt (К-11)"
    },
    {
      "code": "V-12",
      "title": "JSON-LD по типу контента",
      "kind": "allOf",
      "rules": [
        {
          "kind": "jsonHas",
          "path": "content/structured-data.json",
          "keys": [
            "@type"
          ]
        },
        {
          "kind": "jsonHas",
          "path": "content/structured-data.json",
          "keys": [
            "headline"
          ]
        }
      ],
      "ok": "JSON-LD Article на месте",
      "fail": "нет JSON-LD (К-12)"
    },
    {
      "code": "V-13",
      "title": "Редполитика и типографика",
      "kind": "regexAbsent",
      "path": "content/post.md",
      "pattern": " - ",
      "ok": "дефис-минус не используется как тире",
      "fail": "дефис вместо тире (К-13) · см. typographer"
    },
    {
      "code": "V-14",
      "title": "CTA с data-analytics-event",
      "kind": "regexAtLeast",
      "path": "content/post.md",
      "pattern": "data-analytics-event",
      "min": 1,
      "ok": "у CTA есть событие аналитики",
      "fail": "CTA без data-analytics-event (К-14)"
    },
    {
      "code": "V-15",
      "title": "Нет AI-паттернов",
      "kind": "regexAbsent",
      "path": "content/post.md",
      "pattern": "важно отметить|в современном мире|стоит отметить",
      "ok": "AI-штампов нет",
      "fail": "найден AI-паттерн (К-15)"
    }
  ]
}
