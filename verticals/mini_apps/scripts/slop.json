{
  "vertical": "mini_apps",
  "scan": [
    "app"
  ],
  "extensions": [
    ".html",
    ".js",
    ".css",
    ".md"
  ],
  "rules": [
    {
      "code": "B-03",
      "pattern": "window\\.location\\.href",
      "message": "навигация закроет Mini App (B-03)"
    },
    {
      "code": "B-04",
      "pattern": "::-webkit-scrollbar",
      "message": "кастомный скроллбар ломает momentum iOS (B-04)"
    }
  ]
}
