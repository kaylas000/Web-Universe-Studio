:root {
  --bg: var(--tg-theme-bg-color, #ffffff);
  --text: var(--tg-theme-text-color, #111111);
  --button: var(--tg-theme-button-color, #2b6cff);
  --vh: 100vh;
}

.timer {
  min-height: var(--vh);
  max-width: 22rem;
  margin: 0 auto;
  padding: 10vh 1rem calc(1rem + env(safe-area-inset-bottom));
  font-family: system-ui, sans-serif;
  text-align: center;
  color: var(--text);
  background: var(--bg);
}

.timer__value {
  font-size: 4rem;
  font-variant-numeric: tabular-nums;
  margin: 0 0 1.5rem;
}

.timer__state {
  min-height: 1.5rem;
  margin: 0 0 0.75rem;
  font-size: 0.9375rem;
  color: var(--text);
  opacity: 0.85;
}

.timer__state[data-screen="error"] {
  color: #d93025;
  opacity: 1;
}

.timer__controls {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
}

.timer__button {
  min-height: 44px;
  min-width: 44px;
  padding: 0.5rem 1.25rem;
  border: 1px solid var(--button);
  border-radius: 0.5rem;
  background: var(--bg);
  color: var(--text);
}

@media (max-width: 420px) {
  .timer__value { font-size: 3rem; }
}

@media (max-width: 375px) {
  .timer__value { font-size: 2.5rem; }
}

@media (max-width: 320px) {
  .timer__value { font-size: 2rem; }
}
