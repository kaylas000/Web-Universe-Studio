{
  "vertical": "data_analytics",
  "scan": [
    "analysis"
  ],
  "extensions": [
    ".md",
    ".sql"
  ],
  "rules": [
    {
      "code": "B-01",
      "pattern": "SELECT\\s+\\*",
      "message": "SELECT * в продакшн-запросе (B-01)"
    },
    {
      "code": "B-04",
      "pattern": "except\\s*:\\s*pass",
      "message": "проглоченная ошибка (B-04)"
    },
    {
      "code": "B-08",
      "pattern": "password\\s*=\\s*[\"']",
      "message": "хардкод креденшела (B-08)"
    }
  ]
}
